{
  "name": "@abay/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, and the hand-written SQL Prisma cannot express.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prisma",
    "sql",
    "scripts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:check": "node scripts/migrate-check.mjs",
    "studio": "prisma studio",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@abay/config": "0.0.0",
    "typescript": "5.9.3"
  }
}
