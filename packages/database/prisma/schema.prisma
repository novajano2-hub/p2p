// Phase 1 step 2: the identity tables. Phase 1 step 3 adds the separate admin
// realm; Phase 2 adds the ledger. Each arrives with its own migration and,
// where Prisma cannot express a rule (balanced entries, immutability), a
// hand-written SQL file under ../sql applied by that migration.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  // Runtime connections use the least-privilege role.
  url               = env("DATABASE_URL")
  // Migrations use the role that owns the schema. Prisma Migrate reads this one.
  directUrl         = env("DIRECT_DATABASE_URL")
  // A scratch database Prisma replays migrations into when authoring them.
  // Named explicitly so the migrator role does not need CREATEDB. Never points
  // at a database holding real rows: Prisma resets it.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Identifiers are UUIDv7: sortable by creation time like an integer, but not
// guessable and not a count of our customers (ADR-0005). Generated client-side
// so tests and fixtures can mint them without a database round trip.

/// A customer. Administrators are a separate realm with their own table and
/// their own authentication, so a customer-account compromise is never also an
/// administrator compromise (ADR: threat model R-08). Arriving in step 3.
model User {
  id String @id @default(uuid(7))

  /// Stored lower-cased, and every lookup lower-cases first. A citext column
  /// would enforce that in the database, but it needs an extension; a
  /// normalising boundary plus this unique index is the portable equivalent.
  email String @unique

  /// Null until the address is proven. A user cannot reach any money-moving
  /// route before this is set.
  emailVerifiedAt DateTime?

  /// The customer-facing account number, "BQ-" and eight digits, assigned at
  /// creation and never changed. What a person quotes to support and shows a
  /// counterparty; random, so it is neither guessable nor a count of accounts.
  platformId String @unique @map("platform_id")

  /// Chosen by the customer, shown to counterparties. Starts as a generated
  /// placeholder and can be changed. Uniqueness is case-insensitive, enforced
  /// on the lower-cased copy below; this column keeps the casing they typed.
  username String

  /// Lower-cased `username`, the column the unique index lives on.
  usernameKey String @unique @map("username_key")

  status UserStatus @default(ACTIVE)

  /// Where this account stands with identity verification. Denormalised from
  /// the newest KycSubmission on purpose: every authenticated request reads it
  /// to decide what the account may do, and that must not need a join. The
  /// submission rows remain the record of how it got here.
  kycStatus KycStatus @default(NOT_STARTED) @map("kyc_status")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities      AuthIdentity[]
  sessions        Session[]
  kycSubmissions  KycSubmission[]
  kycDocuments    KycDocument[]
  notifications   Notification[]
  addresses       AttributionAddress[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  idempotencyKeys IdempotencyKey[]
  paymentMethods  PaymentMethod[]
  offers          Offer[]
  tradesAsBuyer   Trade[]         @relation("TradeBuyer")
  tradesAsSeller  Trade[]         @relation("TradeSeller")
  traderStats     TraderStats?

  @@map("users")
}

/// Something worth telling a customer that happened without them doing
/// anything on this device - a decision an administrator made, for now.
/// Deleted with the account, unlike AuditEvent: this is what the account was
/// told, not evidence of who decided something, so it has no reason to
/// outlive the account it was sent to.
model Notification {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  /// Written by whoever creates the notification, not composed on read: the
  /// wording an administrator's decision produced (the rejection reason,
  /// specifically) has to survive even if the submission it describes is
  /// later reviewed again.
  title String
  body  String

  /// Where the bell takes you when this one is opened. A path, never a URL.
  link String?

  /// Null means unread. A timestamp rather than a boolean for the same reason
  /// every other "has this happened" column here is one: "unread" says
  /// nothing about when it stopped being true.
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now())

  /// The one read this table exists for: this account's own, newest first.
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  KYC_APPROVED
  KYC_REJECTED
  /// A deposit reached finality and the balance moved.
  DEPOSIT_CREDITED
  /// A withdrawal reached the chain and is confirmed.
  WITHDRAWAL_SENT
  /// A withdrawal did not go ahead; the hold was released back to available.
  WITHDRAWAL_RETURNED
  /// Phase 4 - trades. Each links to the trade it is about.
  TRADE_OPENED
  TRADE_PAID
  TRADE_RELEASED
  TRADE_CANCELLED
  TRADE_EXPIRED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  DISPUTE_WITHDRAWN
  /// Phase 5 - a sell ad the seller's balance cannot cover. Each links to My ads.
  /// Hidden from the market, and later taken offline by the worker.
  OFFER_HIDDEN
  OFFER_PAUSED

  @@map("notification_type")
}

/// One attempt at identity verification. Kept for every attempt, not just the
/// current one: "who approved this account, when, and on what evidence" is a
/// question a regulator and an incident review both ask, and a rejected
/// attempt is part of the answer.
model KycSubmission {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Personal data (docs/architecture/data-classification.md). Held because
  /// the law requires us to know who we are holding money for; never shown to
  /// a counterparty, and never leaves the server except to an administrator.
  legalName      String          @map("legal_name")
  dateOfBirth    DateTime        @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2, upper case.
  country        String
  documentType   KycDocumentType @map("document_type")
  documentNumber String          @map("document_number")

  status KycSubmissionStatus @default(PENDING)

  /// Set when an administrator decides. `reviewedBy` will reference the admin
  /// realm's own table once it exists (Phase 1 step 3); until then it holds
  /// the identifier of whoever ran the review, so the trail is never blank.
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?   @map("reviewed_by")
  /// Shown to the customer when rejected, so a retry can fix the actual problem.
  rejectionReason String?   @map("rejection_reason")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The photographs this attempt is judged on.
  documents KycDocument[]

  /// The two reads that happen often: this customer's attempts, and the
  /// administrator's queue of everything still waiting.
  @@index([userId])
  @@index([status, createdAt])
  @@map("kyc_submissions")
}

/// One photograph: the front of the document, its back, or the selfie that
/// ties the document to the person. The bytes live in the object store under
/// `storageKey`; this row is the record that they exist, whose they are, and
/// which attempt they support.
model KycDocument {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null while the photograph is staged: uploaded, but not yet part of a
  /// submission. Set when the submission is created, and never changed after.
  submissionId String?        @map("submission_id")
  submission   KycSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  kind KycDocumentKind

  /// The key in the object store, e.g. "kyc/<user id>/<document id>.jpg".
  /// A key, never a URL: the store is private, and anything that reads the
  /// bytes back is given a signed, short-lived address by the API.
  storageKey  String @unique @map("storage_key")
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")

  createdAt DateTime @default(now())

  /// Staged photographs are looked up by owner; a submission's by itself.
  @@index([userId, submissionId])
  @@map("kyc_documents")
}

enum KycDocumentKind {
  FRONT
  BACK
  SELFIE

  @@map("kyc_document_kind")
}

enum KycStatus {
  /// Never submitted. Can trade in small amounts; cannot post an offer.
  NOT_STARTED
  /// Submitted, waiting for an administrator. Limits stay as they were.
  PENDING
  /// An administrator confirmed the identity. Full limits.
  APPROVED
  /// An administrator refused it. The customer may correct and submit again.
  REJECTED

  @@map("kyc_status")
}

enum KycSubmissionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("kyc_submission_status")
}

enum KycDocumentType {
  /// Ethiopian national ID (Fayda) or an equivalent government card.
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE

  @@map("kyc_document_type")
}

enum UserStatus {
  /// Normal. Can trade.
  ACTIVE
  /// Set by an administrator. Can log in and withdraw, cannot open new trades.
  SUSPENDED
  /// Closed by the customer or by us. Cannot log in. Rows are kept because
  /// financial history must survive the account that created it.
  CLOSED

  @@map("user_status")
}

/// How a user proves who they are. One row per method, so adding Google to a
/// password account (or the reverse) is an insert rather than a migration, and
/// so a password hash is absent rather than null-and-meaningless for an account
/// that only ever uses Google.
model AuthIdentity {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider AuthProvider

  /// The provider's own identifier for this account: the `sub` claim for
  /// Google, null for a password identity (the address on User is the handle).
  providerAccountId String? @map("provider_account_id")

  /// Argon2id, and only ever for provider = PASSWORD. Never leaves the server,
  /// never appears in a response type, and is redacted from logs by name.
  passwordHash String? @map("password_hash")

  /// Set when the password last changed. A session issued before this is
  /// treated as stale, which is what makes "changing your password logs out
  /// your other devices" true rather than aspirational.
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One identity per provider per user: no two password rows to disagree.
  @@unique([userId, provider])
  /// A Google account can back exactly one user.
  @@unique([provider, providerAccountId])
  @@map("auth_identities")
}

enum AuthProvider {
  PASSWORD
  GOOGLE

  @@map("auth_provider")
}

/// A logged-in session. Opaque and server-side rather than a JWT, because a
/// custodial platform has to be able to end a session *now* - on password
/// change, on a support call, on suspicion - and a self-contained token cannot
/// be recalled before it expires (ADR-0011).
model Session {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque token, never the token itself. Read access to this
  /// table must not be enough to impersonate anyone, which matters because
  /// backups, replicas and support tooling all see it.
  tokenHash String @unique @map("token_hash")

  /// Absolute end of life, independent of activity.
  expiresAt DateTime @map("expires_at")

  /// Moved forward on use, so an abandoned session can be expired for idleness
  /// long before its absolute expiry.
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  /// Revocation is a write, not a delete: "when was this session ended, and was
  /// it ended deliberately" is a question incident review will ask.
  revokedAt     DateTime?         @map("revoked_at")
  revokedReason SessionEndReason? @map("revoked_reason")

  /// Personal data (docs/architecture/data-classification.md). Kept because
  /// "sign out my other devices" and unfamiliar-login checks need it; shown to
  /// the account owner, never to another customer.
  createdIp String? @map("created_ip")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now())

  /// Listing a user's active sessions, and the expiry sweep, are the two reads
  /// that happen often enough to index.
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum SessionEndReason {
  LOGOUT
  PASSWORD_CHANGED
  REVOKED_BY_USER
  REVOKED_BY_ADMIN
  EXPIRED

  @@map("session_end_reason")
}

/// A single-use code or link: the six digits that prove an email address, and
/// the token behind a password-reset link.
///
/// Keyed by address rather than by user, deliberately. Registration creates no
/// User row until the password step succeeds, so an abandoned sign-up leaves
/// nothing behind, and "is this address registered" cannot be answered by
/// watching what the server creates.
model VerificationToken {
  id String @id @default(uuid(7))

  purpose VerificationPurpose

  /// Lower-cased, like User.email.
  email String

  /// Hashed, for the same reason session tokens are: the database should not
  /// hold anything replayable.
  tokenHash String @map("token_hash")

  expiresAt DateTime @map("expires_at")

  /// Set when redeemed. A redeemed row is kept rather than deleted so a replay
  /// is distinguishable from a code that never existed.
  consumedAt DateTime? @map("consumed_at")

  /// Six digits is a million guesses, which is not many. Attempts are counted
  /// here and the row is burned past the limit; rate limiting sits in front as
  /// the second layer.
  attempts Int @default(0)

  createdAt DateTime @default(now())

  /// The lookup is always "the newest live token for this address and purpose".
  @@index([email, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// The second factor on every password login: the password proves the
  /// person knows the secret, the code proves they still hold the inbox.
  LOGIN

  @@map("verification_purpose")
}

// ---------------------------------------------------------------- admin realm
//
// A separate realm from `User`, decided in Phase 0 (open-questions Q2, and the
// threat model's R-08/B7). The property being bought: no path that compromises
// a customer account also compromises an administrator. There is deliberately
// no role flag on `User` anywhere in this schema, and there must never be one -
// the moment one exists, every customer-facing weakness becomes an admin
// weakness too.
//
// Administrators cannot trade. They have no balance, no offers and no wallet,
// because they are not users of the marketplace at all.

/// Someone who can act on the platform rather than in it.
model AdminUser {
  id String @id @default(uuid(7))

  /// Lower-cased, like User.email. Issued, never self-registered: there is no
  /// sign-up route into this table, only `npm run admin:create`.
  email String @unique

  /// So a decision in the queue and a line in the audit log carry a person.
  name String

  /// Argon2id. The only way in. No OAuth, no magic link, and no self-service
  /// recovery: an administrator who loses their password is reset by another
  /// administrator, out of band, which is one fewer remotely reachable flow.
  passwordHash String @map("password_hash")

  /// A session issued before this is stale, exactly as for a customer.
  passwordChangedAt DateTime? @map("password_changed_at")

  /// The second factor (threat model B7.3). RFC 6238 TOTP; the value here is
  /// the base32 secret AES-256-GCM-encrypted with FIELD_ENCRYPTION_KEY, never
  /// the secret itself - a database read must not be enough to mint codes.
  totpSecret String? @map("totp_secret")

  /// A secret that has been shown as a QR but not yet proven with a code.
  /// Promoted to totpSecret on confirmation; harmless while it sits here.
  totpPendingSecret String? @map("totp_pending_secret")

  /// Null means not enrolled - and an un-enrolled session can reach nothing
  /// but the enrollment routes (AdminGuard), which is what makes MFA
  /// mandatory rather than encouraged.
  totpEnrolledAt DateTime? @map("totp_enrolled_at")

  /// The 30-second step of the last accepted code. A code can never be
  /// accepted twice (RFC 6238 section 5.2): each acceptance must claim a
  /// strictly later step than this, atomically.
  totpLastUsedStep BigInt? @map("totp_last_used_step")

  /// Least privilege (B7.1): capability is granted per action and never implied
  /// by being an administrator. An account with an empty list can sign in and
  /// do nothing, which is the correct default for a new one.
  roles AdminRole[]

  status AdminStatus @default(ACTIVE)

  lastSignedInAt DateTime? @map("last_signed_in_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AdminSession[]

  @@map("admin_users")
}

enum AdminRole {
  /// Reads identity documents and decides verification. The only role in use today.
  KYC_REVIEWER
  /// Phase 4. Releases or refunds a disputed trade.
  DISPUTE_RESOLVER
  /// Phase 6. Approves an outgoing withdrawal.
  WITHDRAWAL_APPROVER
  /// Phase 2. Posts a typed, balanced correction. Never a "set balance".
  FINANCIAL_ADJUSTER
  /// Phase 2. Reads accounts, balances and posted history. Moves nothing.
  LEDGER_VIEWER
  /// Phase 3. Decides a deposit held for review, and attributes one that arrived unmatched.
  DEPOSIT_REVIEWER

  @@map("admin_role")
}

enum AdminStatus {
  ACTIVE
  /// Cannot sign in. Sessions are revoked at the same moment.
  SUSPENDED

  @@map("admin_status")
}

/// An administrator's session. A separate table from `Session` on purpose:
/// nothing is shared between the realms, so a bug in customer session handling
/// cannot mint an admin session, and the lifetimes differ by design - hours
/// here against weeks there (B7.3).
model AdminSession {
  id          String    @id @default(uuid(7))
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque token, never the token.
  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  revokedAt     DateTime?         @map("revoked_at")
  revokedReason SessionEndReason? @map("revoked_reason")

  createdIp String? @map("created_ip")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// What an administrator did, why, and to what.
///
/// Append-only, enforced by a trigger rather than by convention (see
/// ../sql/audit-append-only.sql): the answer to "an administrator denies having
/// acted" (B7.4) is worth nothing if the same administrator can edit it.
///
/// The actor is stored as a plain id and a copied-down email rather than as a
/// foreign key. That is deliberate. This table has to outlive the rows it
/// describes, including the administrator: a cascade would erase the evidence
/// and a null would erase the name, and either one defeats the purpose.
model AuditEvent {
  id String @id @default(uuid(7))

  /// Dotted and past tense: "kyc.approved", "admin.signed_in".
  action String

  /// Null for something the system did on its own.
  actorAdminId String? @map("actor_admin_id")
  /// Copied at the time of writing, so the name survives the account.
  actorEmail   String? @map("actor_email")

  /// What was acted on: "kyc_submission" and its id.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Mandatory for a decision, and shown to whoever it affects. Enforced by
  /// the service, because "why" is a product rule rather than a column type.
  reason String?

  /// Enough to see what changed without going back to the row itself, which
  /// may since have changed again.
  before Json?
  after  Json?

  /// Ties the event to the request that caused it, and to the logs from it.
  correlationId String  @map("correlation_id")
  ip            String?

  createdAt DateTime @default(now())

  /// The three questions asked of an audit log: what happened to this thing,
  /// what has this person done, and what happened around this time.
  @@index([subjectType, subjectId])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/**
 * ---------------------------------------------------------------- the ledger
 * Every amount of money the platform owes or controls, as an immutable
 * double-entry record. docs/architecture/ledger-taxonomy.md is the document
 * these models implement; read it before changing anything here.
 * The shape in one sentence: a LedgerTransaction is one business event, it
 * holds two or more LedgerEntry lines that must sum to zero, and
 * LedgerAccountBalance is a rebuildable projection of those lines that exists
 * so a balance can be read and locked without summing history.
 */

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("ledger_account_type")
}

/// One asset at launch. A second one is not a new value here but a decision
/// about clearing between assets, which the taxonomy (L3) defers deliberately.
enum LedgerAsset {
  USDT

  @@map("ledger_asset")
}

enum LedgerDirection {
  DEBIT
  CREDIT

  @@map("ledger_direction")
}

/// Who a set of accounts belongs to. Also in the account's code; stored as a
/// column so "every account of this user" is an index scan rather than a
/// pattern match on a string.
enum LedgerAccountScope {
  USER
  TRADE
  PLATFORM

  @@map("ledger_account_scope")
}

/// Who caused a transaction. SYSTEM is a worker acting on its own - a sweep,
/// an expiry - and carries no actor id.
enum LedgerActorType {
  USER
  ADMIN
  SYSTEM

  @@map("ledger_actor_type")
}

/// Why money moved, as a closed set rather than free text: this drives
/// reporting and is what a support agent reads back. Growing it is a
/// migration, which is the right amount of friction for a new way to move
/// money. Values not yet reachable are declared now because the taxonomy
/// already specifies them; the phase that implements each one is noted.
enum LedgerReason {
  /// Fixtures and local development only, never production (taxonomy 3.6).
  OPENING_BALANCE

  /// Phase 3 - deposits and treasury.
  DEPOSIT_CREDITED
  SWEEP_BROADCAST
  SWEEP_CONFIRMED
  UNIDENTIFIED_DEPOSIT_RECEIVED
  UNIDENTIFIED_DEPOSIT_ATTRIBUTED

  /// Phase 3 - withdrawals.
  WITHDRAWAL_HELD
  WITHDRAWAL_HOLD_RELEASED
  WITHDRAWAL_BROADCAST
  WITHDRAWAL_CONFIRMED

  /// Phase 4 - escrow.
  ESCROW_LOCKED
  ESCROW_RELEASED
  ESCROW_REFUNDED_EXPIRY
  ESCROW_REFUNDED_CANCELLED
  DISPUTE_RESOLVED_RELEASE
  DISPUTE_RESOLVED_REFUND

  /// Phase 3 - reconciliation. Posted by a human adjustment workflow after
  /// investigation, never by the reconciler itself (ADR-0009).
  RECONCILIATION_SURPLUS_RECORDED
  RECONCILIATION_SHORTFALL_WRITTEN_OFF

  @@map("ledger_reason")
}

/// One account in the chart of accounts (taxonomy 2, 3).
///
/// Platform accounts are seeded by the migration and are the same in every
/// environment. User and trade accounts are created on first use, which is why
/// `code` is unique: "get or create the escrow account for this trade" has to
/// be one safe upsert, not a read followed by a race.
model LedgerAccount {
  id String @id @default(uuid(7))

  /// {TYPE}:{SCOPE}:{OWNER}:{ASSET}:{PURPOSE}, e.g.
  /// "LIAB:USER:0190...:USDT:AVAILABLE". Human-readable and the natural key;
  /// the uuid is the one foreign keys use.
  code String @unique

  type  LedgerAccountType
  scope LedgerAccountScope
  asset LedgerAsset

  /// The user or trade this belongs to; null for PLATFORM accounts.
  ownerId String? @map("owner_id")

  /// What this account is for, the last segment of the code: AVAILABLE,
  /// ESCROW, TREASURY_HOT. Free text because purposes are added by new
  /// features rather than chosen from a fixed list.
  purpose String

  createdAt DateTime @default(now())

  balance LedgerAccountBalance?
  entries LedgerEntry[]

  @@index([scope, ownerId])
  @@map("ledger_accounts")
}

/// One business event: a deposit credited, an escrow locked, a trade released.
///
/// Immutable once written, enforced by the database rather than by convention
/// (../sql/ledger-immutability.sql). Correcting a mistake is a new transaction
/// carrying `reversesTransactionId`, never an edit - which is what lets the
/// history show that money went somewhere and came back, rather than showing
/// that it was never there.
model LedgerTransaction {
  id String @id @default(uuid(7))

  /// One asset per transaction (taxonomy L3). Denormalised onto the entries
  /// too, so the balance invariant can be checked without a join.
  asset LedgerAsset

  reason LedgerReason

  /// What business object caused this: "deposit", "trade", "withdrawal", and
  /// its id. A string rather than an enum because the set grows with every
  /// module, and a pointer is not a product decision the way a reason is.
  referenceType String @map("reference_type")
  referenceId   String @map("reference_id")

  actorType LedgerActorType @map("actor_type")
  /// The user or administrator; null when actorType is SYSTEM.
  actorId   String?         @map("actor_id")

  /// Ties the movement to the request and the log lines that caused it.
  correlationId String @map("correlation_id")

  /// Required, and unique: the database is what makes a retried deposit
  /// webhook or a double-clicked release credit exactly once, rather than a
  /// check in application code that a future refactor can lose.
  idempotencyKey String @unique @map("idempotency_key")

  /// Set when this transaction undoes an earlier one - an expiry refund, a
  /// released hold. The original is never touched.
  reversesTransactionId String?             @map("reverses_transaction_id")
  reverses              LedgerTransaction?  @relation("LedgerReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy            LedgerTransaction[] @relation("LedgerReversal")

  createdAt DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([reason, createdAt])
  @@index([createdAt])
  @@index([correlationId])
  @@map("ledger_transactions")
}

/// One posting line: this account, this direction, this much.
///
/// `signedAmount` is `amount` for a debit and `-amount` for a credit, held as
/// its own column so that "does this transaction balance" is a SUM with no
/// CASE in it - the check that matters most should be the cheapest to write
/// and the hardest to get subtly wrong. A CHECK constraint binds it to
/// direction and amount so the two can never disagree.
///
/// `direction` is kept alongside rather than inferred from the sign because a
/// zero-amount leg is legitimate and carries no sign: the fee leg is posted at
/// zero while fees are switched off, so that turning them on is configuration
/// rather than a change to the shape of a transaction (taxonomy JE-4).
model LedgerEntry {
  id String @id @default(uuid(7))

  transactionId String            @map("transaction_id")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  accountId String        @map("account_id")
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  direction    LedgerDirection
  /// Micro-USDT. Never negative; direction carries the sense.
  amount       BigInt
  /// amount for DEBIT, -amount for CREDIT. CHECK-bound to the two above.
  signedAmount BigInt          @map("signed_amount")

  asset LedgerAsset

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

/// The current balance of one account: a projection of its entries, not a
/// second source of truth (ADR-0009).
///
/// It exists for two reasons. Reading a balance must not mean summing every
/// entry an account has ever had. And, more importantly, it is the row that
/// gets locked: moving money out of an account means taking `SELECT ... FOR
/// UPDATE` on this row first, which is what makes two concurrent trades
/// against the same seller queue up instead of both seeing the same funds.
///
/// Maintained by a trigger on the entries rather than by the service, so a
/// posting cannot fail to move the balance. If it is ever wrong it is
/// rebuilt from the entries, which is what makes it safe for it to be
/// writable at all - see the note on permissions in ../sql/ledger-immutability.sql.
model LedgerAccountBalance {
  accountId String        @id @map("account_id")
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  asset LedgerAsset

  /// Micro-USDT, in the account's NATURAL sense: a customer's available
  /// balance of 100 USDT is +100,000,000, not negative, even though it is a
  /// liability whose entries are credits. The floor below is therefore the
  /// floor a person would expect.
  balance BigInt @default(0)

  /// Whether this balance may go below zero. False for everything a customer
  /// or a trade owns and for platform assets; true only where a negative
  /// position is meaningful (equity, revenue, expense). Derived from the
  /// account's type when the account is created, and held here rather than on
  /// the account because this is where the CHECK constraint that consumes it
  /// lives - a constraint cannot read another table.
  allowsNegative Boolean @map("allows_negative")

  /// Cheap evidence for the rebuild test: how many entries this balance is
  /// the sum of, and the last transaction to touch it.
  entryCount        Int     @default(0) @map("entry_count")
  lastTransactionId String? @map("last_transaction_id")

  /// Bumped on every change. Not used for optimistic locking - ADR-0009
  /// rejects that - but it makes "did this move" answerable without
  /// comparing amounts.
  version Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("ledger_account_balances")
}

// ---------------------------------------------------------------------------
// Phase 3: money in and money out. Deposits and withdrawals are state machines
// (docs/architecture/state-machines.md) whose every transition posts through
// the ledger above; attribution addresses are how a deposit is known to be
// somebody's (ADR-0002). Amounts here are the ledger's unit, millionths of a
// USDT; the chain's own integer (18 decimals on BSC) is kept alongside as
// text, for audit, and converted exactly once at the edge (ADR-0005).
// ---------------------------------------------------------------------------

/// The one network at launch. Decided 2026-09-12: BNB Smart Chain (ADR-0006).
enum ChainNetwork {
  BSC

  @@map("chain_network")
}

enum AddressStatus {
  ACTIVE
  /// No longer handed out; deposits arriving here become UNATTRIBUTED.
  RETIRED

  @@map("address_status")
}

/// A customer's deposit address: theirs to receive at, the platform's to spend
/// from. The key behind it lives in the custody provider, never here.
model AttributionAddress {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  network ChainNetwork
  asset   LedgerAsset
  /// Lower-cased; compared lower-cased everywhere.
  address String

  /// The provider's own handles for the wallet the address belongs to.
  custodyWalletRef  String  @map("custody_wallet_ref")
  custodyAccountRef String? @map("custody_account_ref")

  status AddressStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits Deposit[]
  sweeps   Sweep[]

  @@unique([network, address])
  /// One live address per customer per network and asset.
  @@unique([userId, network, asset])
  @@map("attribution_addresses")
}

enum DepositStatus {
  DETECTED
  CONFIRMING
  CREDITED
  ORPHANED
  MANUAL_REVIEW
  UNATTRIBUTED
  REJECTED

  @@map("deposit_status")
}

/// One incoming transfer, from first sighting to credited balance.
model Deposit {
  id String @id @default(uuid(7))

  network     ChainNetwork
  txHash      String       @map("tx_hash")
  logIndex    Int          @map("log_index")
  blockNumber BigInt       @map("block_number")

  fromAddress   String @map("from_address")
  toAddress     String @map("to_address")
  tokenContract String @map("token_contract")
  /// The chain's integer, in the token's smallest unit. Text: it can exceed 64 bits.
  rawAmount     String @map("raw_amount")

  asset  LedgerAsset
  /// In millionths: rawAmount scaled down, floored. What the ledger will credit.
  amount BigInt

  /// Null while unattributed.
  addressId String?             @map("address_id")
  address   AttributionAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  userId    String?             @map("user_id")
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        DepositStatus @default(DETECTED)
  confirmations Int           @default(0)
  /// Why it is held or was refused; shown to an administrator, never guessed at.
  reviewReason  String?       @map("review_reason")

  /// JE-1 or JE-10, once posted. The credit's idempotency key is derived from the deposit id.
  ledgerTransactionId String? @map("ledger_transaction_id")

  /// How it was first seen: "webhook" or "observer". Both paths verify against the chain.
  detectedVia String @map("detected_via")

  /// The administrator who decided a held or unattributed deposit, and why. The
  /// audit event is the authoritative record; this is the copy the row carries.
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  decisionReason String?   @map("decision_reason")

  correlationId String    @map("correlation_id")
  detectedAt    DateTime  @default(now()) @map("detected_at")
  creditedAt    DateTime? @map("credited_at")
  updatedAt     DateTime  @updatedAt

  @@unique([network, txHash, logIndex])
  @@index([status, updatedAt])
  @@index([userId, detectedAt])
  @@index([correlationId])
  @@map("deposits")
}

enum WithdrawalStatus {
  REQUESTED
  RISK_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  BUILDING
  BUILD_FAILED
  SIGNING
  SIGN_REFUSED
  BROADCAST
  BROADCAST_UNKNOWN
  MANUAL_INVESTIGATION
  CONFIRMED
  FAILED_CONFIRMED

  @@map("withdrawal_status")
}

/// One outgoing transfer, from request to confirmed on-chain (ADR-0010).
model Withdrawal {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  network     ChainNetwork
  asset       LedgerAsset
  /// Millionths. What leaves the customer's available balance at request.
  amount      BigInt
  /// Millionths. Zero at launch; posted as its own leg regardless (JE-7).
  fee         BigInt       @default(0)
  destination String

  status WithdrawalStatus @default(REQUESTED)

  riskScore         Int?     @map("risk_score")
  riskReasons       String[] @map("risk_reasons")
  /// How many distinct administrators must approve before it may proceed.
  approvalsRequired Int      @default(0) @map("approvals_required")

  txHash        String? @map("tx_hash")
  providerRef   String? @map("provider_ref")
  blockNumber   BigInt? @map("block_number")
  confirmations Int     @default(0)
  buildAttempts Int     @default(0) @map("build_attempts")
  failureReason String? @map("failure_reason")

  /// The ledger transactions each step posted: the hold (JE-7), the broadcast
  /// (JE-8a), and the settlement - JE-8b when confirmed, JE-9 when the hold was released.
  holdTransactionId      String? @map("hold_transaction_id")
  broadcastTransactionId String? @map("broadcast_transaction_id")
  settledTransactionId   String? @map("settled_transaction_id")

  /// The Idempotency-Key the customer's client sent (ADR-0007).
  clientKey     String @map("client_key")
  correlationId String @map("correlation_id")

  requestedAt DateTime  @default(now()) @map("requested_at")
  broadcastAt DateTime? @map("broadcast_at")
  settledAt   DateTime? @map("settled_at")
  updatedAt   DateTime  @updatedAt

  approvals WithdrawalApproval[]

  @@unique([userId, clientKey])
  @@index([status, updatedAt])
  @@index([userId, requestedAt])
  @@index([correlationId])
  @@map("withdrawals")
}

/// One administrator's approval. Dual approval is two of these from two people.
model WithdrawalApproval {
  id           String     @id @default(uuid(7))
  withdrawalId String     @map("withdrawal_id")
  withdrawal   Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  adminId    String @map("admin_id")
  adminEmail String @map("admin_email")

  /// Which question this administrator answered. SEND authorises the transfer;
  /// FAILED_CONFIRMED attests that nothing ever reached the chain, which is the
  /// one resolution that gives money back and so needs two people (ADR-0010).
  decision WithdrawalDecision @default(SEND)

  reason    String?
  createdAt DateTime @default(now())

  @@unique([withdrawalId, adminId, decision])
  @@map("withdrawal_approvals")
}

enum WithdrawalDecision {
  SEND
  FAILED_CONFIRMED

  @@map("withdrawal_decision")
}

enum SweepStatus {
  PENDING
  BROADCAST
  CONFIRMED
  FAILED

  @@map("sweep_status")
}

/// Moving what sits at an attribution address into treasury (JE-2). A treasury
/// concern: nothing here ever changes a customer's balance.
model Sweep {
  id        String             @id @default(uuid(7))
  addressId String             @map("address_id")
  address   AttributionAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)

  network ChainNetwork
  asset   LedgerAsset
  amount  BigInt

  status      SweepStatus @default(PENDING)
  txHash      String?     @map("tx_hash")
  providerRef String?     @map("provider_ref")
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")

  broadcastTransactionId String? @map("broadcast_transaction_id")
  confirmedTransactionId String? @map("confirmed_transaction_id")

  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("sweeps")
}

/// Which way a reconciliation difference runs.
enum BreakKind {
  /// The chain holds more than the ledger says it should.
  SURPLUS
  /// The chain holds less. The serious one.
  SHORTFALL

  @@map("break_kind")
}

enum BreakStatus {
  OPEN
  /// A person posted the adjustment that accounts for it.
  RESOLVED
  /// A person looked and found it explained; no entry was needed.
  DISMISSED

  @@map("break_status")
}

/// A difference between what the chain holds and what the ledger says it holds.
///
/// Raised by the reconciler, which never posts an entry of its own (ADR-0009).
/// Clearing one is a person's act, through the adjustment workflow, with a
/// reason recorded: JE-11 for a surplus, JE-12 for a written-off shortfall.
model ReconciliationBreak {
  id String @id @default(uuid(7))

  network     ChainNetwork
  asset       LedgerAsset
  /// The ledger account the difference is against, by code.
  accountCode String       @map("account_code")

  kind   BreakKind
  status BreakStatus @default(OPEN)

  /// All in millionths. `difference` is always positive; `kind` carries the direction.
  ledgerBalance BigInt @map("ledger_balance")
  chainBalance  BigInt @map("chain_balance")
  difference    BigInt

  /// What the reconciler saw, kept so a person can check its arithmetic.
  evidence Json

  detectedAt DateTime @default(now()) @map("detected_at")
  /// Bumped when a later pass sees the same open difference again.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  resolvedBy              String?   @map("resolved_by")
  resolvedAt              DateTime? @map("resolved_at")
  resolutionReason        String?   @map("resolution_reason")
  /// The JE-11 or JE-12 a person posted. Null for a dismissed break.
  adjustmentTransactionId String?   @map("adjustment_transaction_id")

  correlationId String @map("correlation_id")

  /// One OPEN break per account - a difference that persists is the same break
  /// seen again, not a new one every minute - enforced by a partial unique index
  /// the migration adds by hand, which Prisma's schema cannot express.
  @@index([status, detectedAt])
  @@index([accountCode, status])
  @@map("reconciliation_breaks")
}

enum OutboxStatus {
  PENDING
  SENT
  /// Gave up after the last attempt. Visible to an administrator, never silently dropped.
  FAILED

  @@map("outbox_status")
}

/// An external effect, written in the same transaction as the change that
/// caused it and delivered later by the worker (ADR-0007). Delivery is
/// at-least-once; every handler is idempotent.
model OutboxEvent {
  id      String @id @default(uuid(7))
  type    String
  payload Json

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  /// Not before this. Advanced on each failed attempt (backoff) and while a worker holds it (lease).
  availableAt DateTime     @default(now()) @map("available_at")
  sentAt      DateTime?    @map("sent_at")
  lastError   String?      @map("last_error")

  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now())

  @@index([status, availableAt])
  @@index([correlationId])
  @@map("outbox_events")
}

/// A claimed Idempotency-Key and the response it produced (ADR-0007). Claimed
/// in the same transaction as the work, so a row exists only for work that
/// committed; a repeat with the same body is answered from here.
model IdempotencyKey {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint    String
  key         String
  requestHash String @map("request_hash")

  responseStatus Int  @map("response_status")
  responseBody   Json @map("response_body")

  createdAt DateTime @default(now())

  @@unique([userId, endpoint, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// The mock chain and custody provider (ADR-0006). Postgres-backed rather than
// in-memory so the API, the worker and the test suite see one chain. Unused
// once a real adapter is configured; never read by domain code, which only
// ever sees the gateway and provider interfaces.
// ---------------------------------------------------------------------------

/// How far the chain observer has scanned, per network. Rescans overlap by the
/// reorg depth, which is safe because detection is idempotent on the transfer.
model ChainObserverCursor {
  network   ChainNetwork @id
  lastBlock BigInt       @map("last_block")
  updatedAt DateTime     @updatedAt

  @@map("chain_observer_cursors")
}

model MockChainHead {
  network   ChainNetwork @id
  height    BigInt       @default(0)
  updatedAt DateTime     @updatedAt

  @@map("mock_chain_heads")
}

model MockChainTransfer {
  id String @id @default(uuid(7))

  network     ChainNetwork
  txHash      String       @map("tx_hash")
  logIndex    Int          @map("log_index")
  blockNumber BigInt       @map("block_number")

  fromAddress   String @map("from_address")
  toAddress     String @map("to_address")
  tokenContract String @map("token_contract")
  rawAmount     String @map("raw_amount")

  /// Set when a simulated reorg drops it: the height at which it vanished.
  orphanedAtBlock BigInt? @map("orphaned_at_block")
  /// Free text for whoever minted it; the test suite tags its own rows.
  tag             String?

  createdAt DateTime @default(now())

  @@unique([network, txHash, logIndex])
  @@index([network, toAddress, blockNumber])
  @@index([network, fromAddress])
  @@map("mock_chain_transfers")
}

enum MockTransferOutcome {
  BROADCAST
  REFUSED
  /// The provider answers "unknown" although the transfer did go out.
  UNKNOWN_BROADCAST
  /// The provider answers "unknown" and nothing went out.
  UNKNOWN_DROPPED

  @@map("mock_transfer_outcome")
}

/// What the mock provider should do with a given client reference. Absent means BROADCAST.
model MockCustodyDirective {
  clientRef String              @id @map("client_ref")
  outcome   MockTransferOutcome
  createdAt DateTime            @default(now())

  @@map("mock_custody_directives")
}

// ---------------------------------------------------------------------------
// Phase 4: the marketplace. An offer is an advertisement; a trade is one
// acceptance of it, with the USDT side held in a per-trade escrow account
// (ADR-0004) and the birr side settled entirely outside the platform, which
// is why a trade carries the seller's payment instructions and a chat, and
// why a dispute exists at all (docs/architecture/state-machines.md 3,
// threat model B8). Amounts are millionths of a USDT; birr is santim,
// hundredths, and never enters the ledger (ledger-taxonomy.md 7).
// ---------------------------------------------------------------------------

/// The rails birr actually moves on in Ethiopia: three mobile wallets and,
/// each a method of its own the way Binance lists them, the four launch
/// banks. A buyer choosing where to pay wants the bank by name - a transfer
/// within one bank arrives at once, one between banks does not.
enum PaymentMethodKind {
  TELEBIRR
  CBE_BIRR
  MPESA
  CBE
  DASHEN
  ABYSSINIA
  AWASH

  @@map("payment_method_kind")
}

enum PaymentMethodStatus {
  ACTIVE
  /// Retired by its owner. Kept because trades snapshot from it and history
  /// must still say where a buyer was told to pay.
  ARCHIVED

  @@map("payment_method_status")
}

/// Where a seller receives birr. The details - account holder, account or
/// phone number - are RESTRICTED (data-classification.md): held as
/// one AES-256-GCM document under FIELD_ENCRYPTION_KEY, decrypted for the
/// owner, for the counterparty of an open trade, and for a dispute resolver
/// with an audit row. Nothing else reads them.
model PaymentMethod {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind PaymentMethodKind

  /// What lists show: the rail and the last digits, "Telebirr ····4821".
  /// Composed by the service from data that is not secret; never typed.
  label String
  /// The last digits of the number, so two methods can be told apart in a
  /// list without decrypting either.
  hint  String

  detailsEncrypted String @map("details_encrypted")

  status     PaymentMethodStatus @default(ACTIVE)
  archivedAt DateTime?           @map("archived_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers OfferPaymentMethod[]
  trades Trade[]

  @@index([userId, status])
  @@map("payment_methods")
}

/// From the publisher's side: a SELL offer sells their USDT for birr, a BUY
/// offer buys USDT with their birr. Whoever gives up USDT funds the escrow
/// (ADR-0004), so on a BUY offer that is the taker.
enum OfferSide {
  BUY
  SELL

  @@map("offer_side")
}

enum OfferStatus {
  ACTIVE
  /// Taken off the marketplace by its owner; can come back.
  PAUSED
  /// Gone for good. Trades already open against it carry on regardless.
  CLOSED

  @@map("offer_status")
}

/// An advertisement. Nothing is locked by posting one: the escrow is taken
/// from the seller when a trade is created, so a SELL offer is shown only
/// while its owner can still fund at least its minimum.
model Offer {
  id     String @id @default(uuid(7))
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  side  OfferSide
  asset LedgerAsset
  /// ISO 4217. One currency at launch; a column so that a second one is a
  /// value rather than a migration.
  fiat  String      @default("ETB")

  /// Santim per one USDT. Fixed: there is no reference index for the birr
  /// that a floating price could honestly follow.
  priceSantim BigInt @map("price_santim")

  /// Millionths of a USDT. `total` is what was posted; `remaining` is what
  /// trades have not yet taken - decremented when a trade opens, restored
  /// when one is cancelled, expires or is refunded.
  totalAmount     BigInt @map("total_amount")
  remainingAmount BigInt @map("remaining_amount")

  /// What one trade may be worth, in santim: the limits a taker sees.
  minSantim BigInt @map("min_santim")
  maxSantim BigInt @map("max_santim")

  /// How long the buyer has to pay before the trade expires (state-machines.md 3).
  paymentWindowMinutes Int @map("payment_window_minutes")

  /// Shown to a taker before they commit. Free text, never instructions
  /// about where to pay - those come from the payment method, at trade time.
  terms     String?
  /// Posted into the trade's chat, as the publisher, the moment a trade opens.
  autoReply String? @map("auto_reply")

  /// Who may take it. Both are checked when a trade is created, not when the
  /// list is shown, because the list is only a suggestion.
  requireVerified    Boolean @default(false) @map("require_verified")
  minCompletedTrades Int     @default(0) @map("min_completed_trades")

  status OfferStatus @default(ACTIVE)

  /// Goes up whenever the advertiser changes something a taker reads before
  /// committing: price, limits, rails, the payment window, the terms, who may
  /// take it. An order names the version it was placed against and is refused
  /// if it has moved (TradeService.create). Somebody else taking from the ad
  /// does not move it, and neither does going offline and back.
  revision Int @default(1)

  /// When the seller's available balance stopped covering this live sell ad's
  /// smallest order, as the worker last saw it (OfferService.checkFunding).
  /// Null while it covers it, and whenever the ad is not live. An ad left
  /// uncovered for OFFER_UNFUNDED_PAUSE_HOURS goes offline by itself.
  unfundedSince      DateTime? @map("unfunded_since")
  /// When its owner was last told it is hidden, so a balance hovering at the
  /// edge does not tell them again every time it dips.
  unfundedNotifiedAt DateTime? @map("unfunded_notified_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentMethods OfferPaymentMethod[]
  trades         Trade[]

  @@index([status, side, priceSantim])
  @@index([userId, status])
  @@map("offers")
}

/// A rail an offer accepts. On a SELL offer each row names one of the
/// seller's own methods - where the buyer will be told to pay. On a BUY
/// offer only the kind is named: the taker is the seller and will pay in
/// through whichever of their own methods matches.
model OfferPaymentMethod {
  id      String @id @default(uuid(7))
  offerId String @map("offer_id")
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  kind PaymentMethodKind

  paymentMethodId String?        @map("payment_method_id")
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([paymentMethodId])
  @@map("offer_payment_methods")
}

/// The trade machine (state-machines.md 3). CREATED is transient: the
/// escrow lock and the row commit together, so the first state a row is
/// ever seen in is AWAITING_FIAT_PAYMENT.
enum TradeStatus {
  AWAITING_FIAT_PAYMENT
  BUYER_MARKED_PAID
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
  REFUNDED

  @@map("trade_status")
}

/// One acceptance of an offer, from escrow lock to settlement. Everything a
/// taker agreed to is copied here at creation - the price, the amount, the
/// payment instructions - so that editing the offer or the payment method
/// afterwards changes nothing about a trade already open (threat model B8.6).
model Trade {
  id String @id @default(uuid(7))

  offerId   String    @map("offer_id")
  /// NoAction, never Cascade: deleting an ad row would otherwise take its
  /// orders with it - and their chat, evidence and disputes - while the ledger
  /// went on recording the money they moved. Ads are closed, never deleted.
  offer     Offer     @relation(fields: [offerId], references: [id], onDelete: NoAction)
  offerSide OfferSide @map("offer_side")

  buyerId  String @map("buyer_id")
  buyer    User   @relation("TradeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String @map("seller_id")
  seller   User   @relation("TradeSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  asset LedgerAsset
  /// Millionths. What the seller's escrow holds until settlement.
  amount BigInt
  /// Millionths. The platform's cut, taken from the escrow at release and paid
  /// by the buyer (JE-4). Zero at launch; a leg is posted regardless.
  fee    BigInt @default(0)

  fiat        String @default("ETB")
  priceSantim BigInt @map("price_santim")
  /// Santim the buyer pays the seller, outside the platform. Reference data
  /// only: the platform never holds it (ledger-taxonomy.md 7).
  fiatSantim  BigInt @map("fiat_santim")

  /// The seller's receiving method for this trade, and its instructions as
  /// they were the moment the trade opened - encrypted the same way the
  /// method itself is. The label and kind are plain so a list can name the
  /// rail without decrypting anything.
  paymentMethodId          String?           @map("payment_method_id")
  paymentMethod            PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentKind              PaymentMethodKind @map("payment_kind")
  paymentLabel             String            @map("payment_label")
  paymentSnapshotEncrypted String            @map("payment_snapshot_encrypted")

  /// The advertiser's terms as they stood when this order opened. Kept here
  /// rather than read from the ad, which its owner may edit afterwards: what
  /// the taker agreed to is part of the order, and a dispute resolver reads it.
  offerTerms String? @map("offer_terms")

  status TradeStatus @default(AWAITING_FIAT_PAYMENT)

  /// Database time, compared with the database's now() by the expirer: with
  /// several processes and their several clocks, whether a trade expired is
  /// a question about money and gets one answer.
  paymentDeadline DateTime  @map("payment_deadline")
  paidAt          DateTime? @map("paid_at")
  /// Set when the trade reaches a terminal state, whichever one.
  closedAt        DateTime? @map("closed_at")
  /// Why it closed, in words for the person it happened to.
  closeReason     String?   @map("close_reason")

  /// JE-3, and the entry that emptied the escrow: JE-4, JE-5 or JE-6.
  escrowTransactionId     String? @map("escrow_transaction_id")
  settlementTransactionId String? @map("settlement_transaction_id")

  /// The chat's message counter. Bumped under the trade's row lock, so every
  /// message has one place in one order and a client can ask for "after N".
  chatSeq Int @default(0) @map("chat_seq")

  /// The Idempotency-Key the taker's client sent (ADR-0007).
  clientKey     String @map("client_key")
  correlationId String @map("correlation_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   TradeEvent[]
  messages TradeMessage[]
  reads    TradeChatRead[]
  dispute  Dispute?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, paymentDeadline])
  @@index([offerId, status])
  @@index([correlationId])
  @@map("trades")
}

enum TradeEventKind {
  CREATED
  MARKED_PAID
  CANCELLED
  EXPIRED
  RELEASED
  DISPUTE_OPENED
  DISPUTE_WITHDRAWN
  DISPUTE_RESOLVED

  @@map("trade_event_kind")
}

/// The trade's timeline: every change of state, who caused it, and when.
/// Written in the same transaction as the change, so the timeline a dispute
/// resolver reads is complete by construction (AT-8). Also what the chat
/// shows between the messages, as system notices.
model TradeEvent {
  id      String @id @default(uuid(7))
  tradeId String @map("trade_id")
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  kind TradeEventKind

  /// The party who acted, or the administrator, or neither for the expirer.
  actorUserId  String? @map("actor_user_id")
  actorAdminId String? @map("actor_admin_id")
  data         Json?

  createdAt DateTime @default(now())

  @@index([tradeId, createdAt])
  @@map("trade_events")
}

enum TradeMessageKind {
  TEXT
  IMAGE

  @@map("trade_message_kind")
}

/// One message between the two parties. `seq` is the trade's own counter,
/// assigned under the trade's row lock: the order is decided once, in the
/// database, and a client that reconnects asks for everything after the
/// last one it saw. `clientMessageId` is the client's own idempotency key,
/// so a retry over a bad connection is the same message and not a repeat.
model TradeMessage {
  id      String @id @default(uuid(7))
  tradeId String @map("trade_id")
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  seq      Int
  senderId String @map("sender_id")

  kind TradeMessageKind
  body String?

  /// For an IMAGE: the object store key, and what was sniffed from the bytes.
  storageKey  String? @unique @map("storage_key")
  contentType String? @map("content_type")
  sizeBytes   Int?    @map("size_bytes")

  clientMessageId String @map("client_message_id")

  createdAt DateTime @default(now())

  @@unique([tradeId, seq])
  @@unique([tradeId, senderId, clientMessageId])
  @@map("trade_messages")
}

/// How far each party has read. One row per party per trade.
model TradeChatRead {
  tradeId String @map("trade_id")
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId  String @map("user_id")

  lastReadSeq Int      @default(0) @map("last_read_seq")
  updatedAt   DateTime @updatedAt

  @@id([tradeId, userId])
  @@map("trade_chat_reads")
}

enum DisputeStatus {
  OPEN
  /// Withdrawn by whoever opened it; the trade goes back to waiting for the seller.
  WITHDRAWN
  RESOLVED

  @@map("dispute_status")
}

/// Why a party appealed, as a closed set a resolver can filter and count by.
enum DisputeReason {
  /// The seller: the buyer marked paid and nothing arrived.
  PAYMENT_NOT_RECEIVED
  /// The buyer: paid, and the seller will not release.
  PAYMENT_NOT_RELEASED
  /// The seller: something arrived, and not the agreed amount.
  WRONG_AMOUNT
  /// The seller: the payer's name is not the buyer's (threat model B8.4).
  THIRD_PARTY_PAYMENT
  SUSPECTED_FRAUD
  OTHER

  @@map("dispute_reason")
}

enum DisputeOutcome {
  /// The buyer paid: escrow to the buyer (JE-6).
  RELEASE_TO_BUYER
  /// The buyer did not: escrow back to the seller (JE-5).
  REFUND_TO_SELLER

  @@map("dispute_outcome")
}

/// An appeal on a trade the buyer says they paid. One per trade: a second
/// disagreement is the same disagreement. Resolved only by an administrator
/// holding DISPUTE_RESOLVER who is not a party (AT-8), or ended by the seller
/// releasing after all, or withdrawn by whoever opened it.
model Dispute {
  id      String @id @default(uuid(7))
  tradeId String @unique @map("trade_id")
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  openedById  String        @map("opened_by_id")
  reason      DisputeReason
  description String

  status  DisputeStatus   @default(OPEN)
  outcome DisputeOutcome?

  /// The administrator who decided, copied down as the audit event copies it,
  /// and why - in their own words, for the parties.
  resolvedById    String?   @map("resolved_by_id")
  resolvedByEmail String?   @map("resolved_by_email")
  resolutionNote  String?   @map("resolution_note")
  resolvedAt      DateTime? @map("resolved_at")
  withdrawnAt     DateTime? @map("withdrawn_at")

  correlationId String @map("correlation_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence DisputeEvidence[]

  @@index([status, createdAt])
  @@map("disputes")
}

/// A screenshot or statement a party attached. RESTRICTED: private bucket,
/// read only through the dispute it belongs to, by its parties and the
/// resolver (threat model B5.2).
model DisputeEvidence {
  id        String  @id @default(uuid(7))
  disputeId String  @map("dispute_id")
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  uploadedById String  @map("uploaded_by_id")
  storageKey   String  @unique @map("storage_key")
  contentType  String  @map("content_type")
  sizeBytes    Int     @map("size_bytes")
  note         String?

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("dispute_evidence")
}

/// What the marketplace shows beside a name: how many trades, how many went
/// through, how quickly they pay and release. Counters maintained in the
/// same transaction as the trade transition that moves them, so they cannot
/// disagree with the trades. Every duration is milliseconds.
model TraderStats {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Trades entered, on either side.
  tradesTotal     Int @default(0) @map("trades_total")
  tradesCompleted Int @default(0) @map("trades_completed")
  /// Trades this account let fail: cancelled or expired while it was the
  /// buyer, or a dispute decided against it.
  tradesFailed    Int @default(0) @map("trades_failed")

  /// As a seller: from the buyer marking paid to the release.
  releaseTotalMs BigInt @default(0) @map("release_total_ms")
  releaseCount   Int    @default(0) @map("release_count")
  /// As a buyer: from the trade opening to marking paid.
  payTotalMs BigInt @default(0) @map("pay_total_ms")
  payCount   Int    @default(0) @map("pay_count")

  updatedAt DateTime @updatedAt

  @@map("trader_stats")
}
