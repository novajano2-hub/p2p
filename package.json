{
  "name": "abay-p2p",
  "version": "0.0.0",
  "private": true,
  "description": "ETB/USDT peer-to-peer marketplace. Placeholder brand: Abay.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:api": "turbo run test:api",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "npm run migrate:dev -w @abay/database --",
    "db:deploy": "npm run migrate:deploy -w @abay/database",
    "db:status": "npm run migrate:status -w @abay/database",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "pin": "node scripts/pin-versions.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
