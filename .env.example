# Copy to .env for local development. Every value here is a placeholder that
# works against docker-compose.yml and nothing else. Real credentials never go
# in a file in this repository; production reads them from a secrets manager.
#
# The API validates all of these at boot and refuses to start if one is
# missing or malformed (apps/api/src/config/env.ts).

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=debug

# Set true only behind a reverse proxy that sets X-Forwarded-*; otherwise a
# client can spoof its own IP to the rate limiter.
TRUST_PROXY=false

# Comma-separated exact origins. No wildcards. The web app in development:
CORS_ORIGINS=http://localhost:3000

# Where the browser lives, and where this API is reachable from the browser.
# A finished Google sign-in sends the browser back to WEB_URL; Google is told
# to redirect to API_URL, so it must be this process's public origin. Both
# must be on the same site (localhost:3000 / localhost:3001 here; birq.com /
# api.birq.com in production) or the session cookie is dropped.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Shown in emails. Placeholder brand, mirrored from apps/web/lib/site.ts.
APP_NAME=BIRQ

# Email. Verification codes are sent through Resend (https://resend.com):
# 3,000 a month free, one API key, no SDK. EMAIL_FROM is the sender. Until a
# domain is verified in Resend, the only sender it accepts is
# onboarding@resend.dev, and only to the address that owns the Resend account.
# Leave RESEND_API_KEY blank in development to have codes written to the API
# log instead of sent; production refuses to start without it.
EMAIL_FROM=BIRQ <onboarding@resend.dev>
RESEND_API_KEY=

# Sign in with Google. Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
#   <API_URL>/v1/auth/google/callback
# as an authorised redirect URI. Leave both blank to keep the option off; the
# button then reports it as unavailable rather than half-working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Two connection strings, two roles (packages/database/sql/roles.sql):
#   DATABASE_URL         the runtime role: read/write rows, cannot change schema
#   DIRECT_DATABASE_URL  the migration role: owns the schema, used by migrations only
#
# Port 5433, matching docker-compose.yml: this project's Postgres runs beside
# any native Postgres you already have on the default 5432, not instead of it.
DATABASE_URL=postgresql://abay_app:app@localhost:5433/abay?schema=public
DIRECT_DATABASE_URL=postgresql://abay_migrator:migrator@localhost:5433/abay?schema=public
# Scratch database for authoring migrations (prisma migrate dev / diff).
# Prisma RESETS whatever this points at, so it must never hold real rows.
SHADOW_DATABASE_URL=postgresql://abay_migrator:migrator@localhost:5433/abay_shadow?schema=public

REDIS_URL=redis://localhost:6379

# How long in-flight requests get to finish on SIGTERM before the process exits.
SHUTDOWN_TIMEOUT_MS=10000

# Sessions. Absolute lifetime, and an idle window after which an abandoned
# session is dead regardless of the absolute one.
SESSION_TTL_HOURS=720
SESSION_IDLE_TTL_HOURS=168
# MUST be true anywhere the site is served over HTTPS. False only because local
# development is http://localhost, where a Secure cookie would never be sent.
COOKIE_SECURE=false

# Widens the session cookie to a parent domain. Unset in development, where the
# web app and the API share the host `localhost` and the cookie already reaches
# both. In production they do not (birq.com and api.birq.com), and the web
# server has to see the cookie for middleware.ts to send a signed-in visitor
# from / straight to /account. Set it to the registrable domain with a leading
# dot, e.g. .birq.com. Without it the redirect simply does not happen; nothing
# else breaks.
# COOKIE_DOMAIN=.birq.com
