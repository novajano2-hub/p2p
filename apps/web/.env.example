# Copy to .env.local for local development. Required: the app refuses to
# build without it, so no URL or port is ever assumed.
#
# Where the browser reaches the API. NEXT_PUBLIC_ means the value is inlined
# into the JavaScript bundle at build time, so it must contain nothing secret.
#
# It has to be on the SAME SITE as the page, or the session cookie is dropped.
# "Site" ignores the port but not the host: localhost:3000 -> localhost:3001 is
# fine, localhost:3000 -> 127.0.0.1:3001 is not, and will leave you looking
# permanently signed out with no error anywhere. In production this is the API
# subdomain of the site itself, e.g. https://api.abay.com beside https://abay.com.
NEXT_PUBLIC_API_URL=http://localhost:3001
