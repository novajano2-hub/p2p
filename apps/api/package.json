{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "BIRQ API. NestJS on Fastify; the HTTP server and the workers share one codebase.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:api": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects api --runInBand",
    "test:all": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@abay/contracts": "0.0.0",
    "@abay/database": "0.0.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-fastify": "11.2.3",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@abay/config": "0.0.0",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
